{
  "name": "chrome-devtools-mcp",
  "version": "1.13.0",
  "description": "MCP server for Chrome DevTools",
  "type": "module",
  "bin": {
    "chrome-devtools-mcp": "./out/Default/gen/src/bin/chrome-devtools-mcp.js",
    "chrome-devtools": "./out/Default/gen/src/bin/chrome-devtools.js"
  },
  "main": "./out/Default/gen/src/index.js",
  "scripts": {
    "cli:generate": "node scripts/generate-cli.ts",
    "clean": "node scripts/clean.ts",
    "clean:submodules": "node scripts/clean-submodules.ts",
    "build": "node scripts/ninja.ts",
    "build:release": "node scripts/gn-gen.ts --args=is_debug=false && node scripts/ninja.ts",
    "typecheck": "node scripts/ninja.ts",
    "format": "eslint --cache --fix . && prettier --write --cache .",
    "check-format": "eslint --cache . && prettier --check --cache .",
    "gen": "npm run build && npm run cli:generate && npm run docs:generate && npm run update-metrics && npm run format",
    "docs:generate": "node scripts/generate-docs.ts",
    "start": "npm run build && node out/Default/gen/src/bin/chrome-devtools-mcp.js",
    "start-debug": "NODE_DEBUG=mcp:* npm run build && node out/Default/gen/src/bin/chrome-devtools-mcp.js",
    "test": "npm run build && node scripts/test.js",
    "test:no-build": "node scripts/test.js",
    "test:only": "npm run build && node scripts/test.js --test-only",
    "test:update-snapshots": "npm run build && node scripts/test.js --test-update-snapshots",
    "prepare": "node scripts/prepare.ts",
    "gn:gen": "node scripts/gn-gen.ts",
    "sync": "npm ci && git submodule update --init && node scripts/gclient-sync.ts",
    "verify-server-json-version": "node scripts/verify-server-json-version.ts",
    "update-lighthouse": "node scripts/update-lighthouse.ts",
    "update-metrics": "node scripts/update_metrics.ts",
    "verify-npm-package": "node scripts/verify-npm-package.js",
    "eval": "npm run build && node scripts/eval_gemini.ts",
    "count-tokens": "node scripts/count_tokens.ts",
    "profile": "npm run build:release && node scripts/profile/profile_mcp.ts",
    "test:memory": "npm run build:release && node scripts/profile/profile_mcp.ts --threshold-percentage 1",
    "profile:footprint": "npm run build:release && node scripts/profile/footprint_mcp.ts"
  },
  "files": [
    "out/Default/gen/src",
    "LICENSE",
    "skills",
    "!**/*.tsbuildinfo",
    "!**/*.js.map",
    "!**/*.d.ts",
    "!**/*-tsconfig*.json",
    "!**/*.meta.json",
    "!**/*.stamp",
    "!**/*.d"
  ],
  "repository": "ChromeDevTools/chrome-devtools-mcp",
  "author": "Google LLC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ChromeDevTools/chrome-devtools-mcp/issues"
  },
  "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp#readme",
  "mcpName": "io.github.ChromeDevTools/chrome-devtools-mcp",
  "devDependencies": {
    "@blackwell-systems/gcf": "^2.2.2",
    "@google/genai": "^2.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@toon-format/toon": "^4.1.0",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.7.1",
    "@types/sinon": "^22.0.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "core-js": "3.51.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.2.0",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.0.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.6.2",
    "puppeteer": "25.17.0",
    "semver": "^7.7.4",
    "sinon": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.43.0",
    "yargs": "18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@blackwell-systems/gcf": "^2.2.2",
    "@toon-format/toon": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@toon-format/toon": {
      "optional": true
    },
    "@blackwell-systems/gcf": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "puppeteer-core": "$puppeteer"
  },
  "allowScripts": {
    "core-js": false,
    "@google/genai": false,
    "protobufjs": false,
    "unrs-resolver": false,
    "puppeteer": true
  }
}
