exports[`CssFormatter > formats transition, animation, and attributes styles toJSON 1`] = `
{
  "element": {
    "uid": "table-1",
    "selector": "table#data"
  },
  "rules": [
    {
      "type": "transition",
      "selector": "transitions style",
      "properties": [
        {
          "name": "opacity",
          "value": "1",
          "status": "active"
        }
      ]
    },
    {
      "type": "animation",
      "name": "pulse",
      "selector": "pulse animation",
      "properties": [
        {
          "name": "transform",
          "value": "scale(1.2)",
          "status": "active"
        }
      ]
    },
    {
      "type": "attributes",
      "selector": "table[attributes style]",
      "properties": [
        {
          "name": "border",
          "value": "1px",
          "status": "active"
        }
      ]
    }
  ]
}
`;

exports[`CssFormatter > formats transition, animation, and attributes styles toString 1`] = `
Styles for table#data (uid: "table-1"):

  transitions style {
    opacity: 1;
  }

  pulse animation {
    transform: scale(1.2);
  }

  table[attributes style] {
    border: 1px;
  }
`;
