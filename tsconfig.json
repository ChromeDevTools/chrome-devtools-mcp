      "ES2023",
      "DOM",
      "ES2024.Promise",
      "ESNext.Disposable",
      "ESNext.Iterator",
      "ESNext.Collection"
    ],
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "filesystem"],
    "moduleResolution": "bundler",
    "outDir": "./build",
    "rootDir": ".",
